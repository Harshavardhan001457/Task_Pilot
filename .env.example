# ASTRA Sentinel - LLM Configuration Template
# Copy this file to .env and insert your API keys

# LLM Provider: "openrouter" or "groq"
LLM_PROVIDER=groq

# OpenRouter Configuration
# Get your API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# # Recommended models: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, meta-llama/llama-3.3-70b-instruct, google/gemini-2.0-flash-001
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq Configuration (alternative)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=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
